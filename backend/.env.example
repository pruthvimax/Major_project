# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (optional — leave blank to disable online payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Server Port configuration
PORT=5000

# Platform commission charged on every paid order, in percent (2 = 2%)
PLATFORM_COMMISSION_RATE=2

# ── Agri Agent logistics integration ─────────────────────────
# Base URL of the Agri Agent API (no trailing slash)
AGRI_AGENT_API_URL=
# Shared secret used BOTH ways: sent as x-api-key when pushing orders,
# and required on POST /api/integration/order-status callbacks.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGRI_AGENT_API_KEY=
# Optional. For the real Agri Agent (Supabase) use:
#   AGRI_AGENT_API_URL=https://<PROJECT_REF>.supabase.co
#   AGRI_AGENT_ORDER_PATH=/functions/v1/ingest-marketplace-order
# (the default below matches the local mock: npm run mock:agri-agent)
AGRI_AGENT_ORDER_PATH=/api/integration/orders
AGRI_AGENT_CALLBACK_URL=
AGRI_AGENT_TIMEOUT_MS=10000
